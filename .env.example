# Copy this file to ".env" (same folder) and fill in your links. ".env" is git-ignored, so it never reaches GitHub.
# Values are read at build time (npm run build) and baked into docs/index.html. See README note.
#
# Optional. Leave both links empty and the tutorial card is simply hidden.

# Player link: OneDrive -> open the video -> Share/Embed -> copy the src="..." value from the iframe code
VITE_TUTORIAL_EMBED_URL=

# Normal viewer link (used for the "Open in new tab" button, and as a fallback if there is no embed link)
VITE_TUTORIAL_OPEN_URL=

# Optional card heading / text
VITE_TUTORIAL_TITLE=Watch the tutorial
VITE_TUTORIAL_DESCRIPTION=A short walkthrough of how to use this report.
